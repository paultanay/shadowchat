# ShadowChat Go Backend Environment Variables

ENV=development
PORT=8080

# Database Configuration (Postgres)
# Use 'localhost' for host-level run, 'postgres' for docker network run.
DATABASE_URL=postgres://shadow:shadowsecret@localhost:5432/shadowchat?sslmode=disable

# Cache Configuration (Redis)
# Use 'localhost' for host-level run, 'redis' for docker network run.
REDIS_URL=localhost:6379

# Broker Configuration (NATS JetStream)
# Use 'localhost' for host-level run, 'nats' for docker network run.
NATS_URL=nats://localhost:4222

# Encryption Keys (Must be randomized strings in production)
TURN_SECRET=shadowchatdevsecretkey1234567890
JWT_SECRET=shadowchatdevjwtsecretkey9876543210
