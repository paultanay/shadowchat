# ShadowChat Signaling Server — Environment Variables

ENV=development
PORT=8080

# Required — must be a strong random value in production
JWT_SECRET=dev-jwt-secret-change-in-production

# TURN credentials (optional — only needed when a TURN server is configured)
TURN_SECRET=dev-turn-secret-change-in-production
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp,turns:localhost:5349?transport=tcp

# Redis (optional — omit to run without presence cache)
# REDIS_URL=localhost:6379

# NATS (optional — omit for single-instance mode)
# NATS_URL=nats://localhost:4222

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
