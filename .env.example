# 🜏 SHADOWCHAT — MASTER ENVIRONMENT CONFIGURATION

# ─── Environment ───
ENV=development
PORT=8080

# ─── PostgreSQL Database ───
# If running via docker-compose: postgres:5432
# If running locally on host OS: localhost:5432 (ensure your local postgres matches these credentials)
DATABASE_URL=postgres://shadow:shadowsecret@localhost:5432/shadowchat?sslmode=disable

# ─── Redis Cache ───
# If running via docker-compose: redis:6379
# If running locally on host OS: localhost:6379
REDIS_URL=localhost:6379

# ─── NATS JetStream Message Broker ───
# If running via docker-compose: nats://nats:4222
# If running locally on host OS: nats://localhost:4222
NATS_URL=nats://localhost:4222

# ─── Cryptographic Secrets (MUST change in production) ───
TURN_SECRET=shadowchatdevsecretkey1234567890
JWT_SECRET=shadowchatdevjwtsecretkey9876543210

# ─── Frontend Next.js Public URLs ───
# These variables configure the frontend to talk to the backend reverse proxy
NEXT_PUBLIC_WS_URL=wss://api.shadowchat.local/ws
NEXT_PUBLIC_API_URL=https://api.shadowchat.local
