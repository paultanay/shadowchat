# ─── Runtime environment ───
ENV=development
PORT=8080

# ─── Required secrets (must be changed in production) ───
JWT_SECRET=dev-jwt-secret-change-in-production

# ─── TURN server credentials (optional — only needed when coturn is running) ───
TURN_SECRET=dev-turn-secret-change-in-production
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp,turns:localhost:5349?transport=tcp

# ─── Redis (optional — leave empty to run without presence cache) ───
# Enabled when running with: docker compose --profile cache up
# REDIS_URL=localhost:6379

# ─── NATS (optional — leave empty for single-instance mode) ───
# Enabled when running with: docker compose --profile cluster up
# NATS_URL=nats://localhost:4222

# ─── CORS (comma-separated allowed origins) ───
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ─── Frontend public env vars ───
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080/ws
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
