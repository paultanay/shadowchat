# ─── Environment ───
ENV=development
PORT=8080

# ─── PostgreSQL ───
# docker-compose: postgres://shadow:shadowsecret@postgres:5432/shadowchat?sslmode=disable
# local:           postgres://shadow:shadowsecret@localhost:5432/shadowchat?sslmode=disable
DATABASE_URL=postgres://shadow:shadowsecret@localhost:5432/shadowchat?sslmode=disable

# ─── Redis (optional — leave empty to skip) ───
# docker-compose: redis:6379
# local:           localhost:6379
REDIS_URL=localhost:6379

# ─── NATS (optional — leave empty to skip) ───
# docker-compose: nats://nats:4222
# local:           nats://localhost:4222
NATS_URL=nats://localhost:4222

# ─── Secrets (MUST change in production) ───
TURN_SECRET=dev-turn-secret-change-in-production
JWT_SECRET=dev-jwt-secret-change-in-production

# ─── Comma-separated TURN server URLs ───
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp,turns:localhost:5349?transport=tcp

# ─── CORS allowed origins (comma-separated) ───
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://localhost:8080
# For production: set to your frontend domain (e.g. https://shadowchat.vercel.app)
# Use * only for testing (disables credentials)

# ─── Frontend env vars (must be prefixed with NEXT_PUBLIC_) ───
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080/ws
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
